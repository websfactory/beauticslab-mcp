/**
 * Wrangler config for beauticslab-mcp.
 * Reference: docs/DESIGN.md §6.2, 부록 C (cloudflare/ai demo wrangler.jsonc).
 *
 * Secrets to set (do NOT commit):
 *   wrangler secret put ASSERTION_VERIFY_KEY     # Next.js와 공유하는 HMAC 키 (assertion JWT 검증)
 *   wrangler secret put INTERNAL_HMAC_KEY        # Worker → Next.js HMAC 서명 키
 *   wrangler secret put NEXTJS_INTERNAL_BASE_URL # https://beauticslab.com
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beauticslab-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  // global_fetch_strictly_public: CIMD 문서 fetch가 우리 zone 내부로 되돌아오는 것을 막는다(SSRF 방지).
  // clientIdMetadataDocumentEnabled=true 이면 필수 — 없으면 OAuthProvider 생성자가 throw.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "mcp.beauticslab.com/*", "zone_name": "beauticslab.com" }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BeauticsLabMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BeauticsLabMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  // /register 남용 방지. Cloudflare Workers Rate Limiting API.
  // period 는 10 또는 60 만 허용된다.
  //
  // ★한도를 5/60s 로 잡은 이유: 이 API 는 카운터를 머신 로컬에 캐시하고 배후 저장소와
  // 비동기로 맞춘다. 그래서 초기에 undercount 가 일어나 명목 한도보다 훨씬 관대하게 통과시킨다
  // (운영 실측 2026-09-02: 20/60s 설정에서 순차 40건이 전부 통과). 명목값을 낮춰 보정한다.
  // 실사용은 월 13건이라 5/60s 여도 정상 클라이언트와는 두 자릿수 배 차이다.
  //
  // ★분산 공격은 막지 못한다(카운터가 Cloudflare 지역별로 분리). 보안 경계가 아니라
  // KV 하루 쓰기 한도(무료 1,000건)를 지키기 위한 감쇄 장치다.
  "ratelimits": [
    {
      "name": "REGISTER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "c50a2e2a757349c3b380e7699b35f911",
      "preview_id": "a7892602c0ad440ab11fd0898898cf48"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8791,
    "ip": "0.0.0.0",
    // routes 설정의 host(mcp.beauticslab.com)를 wrangler dev가 request.url에 자동 inject하는 동작 회피.
    // 참조: https://github.com/cloudflare/workers-sdk/issues/3635 — routes 패턴에서 hostname 추론하는 게 dev에서 의도된 동작.
    // dev.host="localhost"로 강제해야 PRM/audience/WWW-Authenticate 모두 일관되게 localhost:8791로 서빙됨.
    "host": "localhost:8791"
  }
}
